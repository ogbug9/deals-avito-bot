# Telegram: токен от @BotFather, chat id — ваш (узнать через @userinfobot)
TG_TOKEN=
TG_CHAT_ID=

DB_PATH=gpuflip.db

# Что собирать, задаётся в sources.json (вкладка «Настройка сбора» в интерфейсе: python -m gpuflip ui).
# Разовый обход произвольной ссылки: python -m gpuflip scan --url "<ссылка>"

# Прокси для парсинга (по желанию): http://user:pass@host:port
SCRAPE_PROXY=

# --- экономика (стартовые значения, подстраивать по реальным сделкам) ---
MAX_PRICE=40000        # потолок цены под ваш оборотный капитал
MIN_PROFIT_RUB=1500
MIN_PROFIT_PCT=0.15
NEGOTIATION_DISCOUNT=0.10
FIXED_COSTS=400

# --- сборщик (Chrome через Playwright) ---
# DELAY_SEC=15         # пауза между страницами, с; меньше — Авито даёт капчу
# MAX_PAGES=5
# CAPTCHA_WAIT=180     # сколько ждать, пока вы пройдёте капчу в окне Chrome
# CHROME_PROFILE=.chrome-profile

# --- режимы поиска перекосов (1 — включён, 0 — выключен) ---
MODE_BUNDLES=1        # разбор целых ПК на детали
MODE_REGIONAL=1       # лот в регионе с Авито Доставкой против московской медианы
MODE_BADTEXT=1        # модель только в описании или с опечаткой
MODE_URGENT=1         # срочные продажи: порог прибыли 10% вместо 15%
MODE_CATEGORIES=1     # ОЗУ, процессоры, БП, диски
# Доп. регионы для режима 2 (коды из адреса Авито), обходятся только видеокарты с доставкой:
# REGIONS=sankt-peterburg,kazan,ekaterinburg
# REGION_MAX_PAGES=2
DELIVERY_COST=500     # доставка из региона, ₽
ALERT_MARKET_N=10     # алерт только если в позиции столько объявлений; при 6–9 — пометка «мало данных»
RECHECK_PER_CYCLE=3   # сколько карточек перепроверять за обход (живы ли ещё)

# --- расписание и защита от блокировок (удобнее менять в «Настройках») ---
LIGHT_CYCLE=1             # лёгкий цикл: 1-я страница приоритетных источников
LIGHT_MIN_SEC=180         # лёгкий цикл не чаще чем раз в столько секунд…
LIGHT_MAX_SEC=300         # …и не реже (берётся случайно в этих пределах)
FULL_INTERVAL_SEC=3600    # полный обход всех источников
MAX_REQUESTS_PER_HOUR=45  # потолок загрузок страниц Авито в час
DEEP_PER_CYCLE=3          # сколько карточек читать целиком за полный обход
